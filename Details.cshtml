@model EventVm
@{ViewData["Title"]="Event details";}@if(Model==null){<h2>Event not found</h2>}else{<div class="card p-4"><span class="badge text-bg-primary">@Model.EVENT_TYPE</span><h1 class="page-title mt-2">@Model.EVENT_NAME</h1><p>@Model.DESCRIPTION</p><p><b>Date:</b> @Model.EVENT_DATE.ToString("dd MMM yyyy")</p><p><b>Location:</b> @Model.LOCATION</p><p><b>Distance:</b> @Model.DISTANCE km</p><h4>Categories</h4>@foreach(var c in (ViewBag.Categories as List<CategoryVm>??new()).Where(x=>x.EVENT_ID==Model.EVENT_ID)){<div class="border rounded p-3 mb-2"><b>@c.CATEGORY_NAME</b> • @c.DISTANCE km • R @c.ENTRY_FEE @if(Context.Session.IsRole("Participant")){<form asp-controller="Enrolments" asp-action="Enter" method="post" class="d-inline"><input type="hidden" name="categoryId" value="@c.CATEGORY_ID"/><button class="btn btn-warning btn-sm">Enter event</button></form>}</div>}</div>}
