@using RaceDay.MVC.Services
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101b33" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
        <div class="container rd-container">
            <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-flag-fill"></i></span><span>RACE<span class="brand-accent">DAY</span></span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#raceDayNav" aria-controls="raceDayNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="raceDayNav">
                <ul class="navbar-nav mx-auto align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Explore events</a></li>
                    @if (Context.Session.IsRole("Organiser"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Enrolments" asp-action="Index">Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Results" asp-action="Index">Results</a></li>
                    }
                    @if (Context.Session.IsRole("Participant"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Index">My dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a></li>
                    }
                    @if (Context.Session.IsLoggedIn())
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a></li>
                    }
                </ul>
                <div class="nav-actions">
                    @if (Context.Session.IsLoggedIn())
                    {
                        <span class="welcome-user">Hi, @Context.Session.GetString("UserName")</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-nav-outline" type="submit">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-nav-login" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-rd-primary" asp-controller="Account" asp-action="Register">Create account <i class="bi bi-arrow-up-right"></i></a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        <div class="container rd-container pt-3">
            @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
        </div>
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container rd-container footer-inner">
            <a class="rd-brand footer-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-flag-fill"></i></span><span>RACE<span class="brand-accent">DAY</span></span></a>
            <p>Find your event. Challenge yourself. Own your finish line.</p>
            <span class="footer-copy">© @DateTime.Now.Year RaceDay. Run your race.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
