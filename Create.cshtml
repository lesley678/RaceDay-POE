@model ResultVm
@{ViewData["Title"]="Enter result";}<h1 class="page-title">Enter race result</h1><div class="card p-4"><div asp-validation-summary="All" class="text-danger"></div><form method="post"><label class="form-label">Enrolment ID</label><input asp-for="ENROLMENT_ID" class="form-control mb-2"/><label class="form-label">Finish time</label><input asp-for="FINISH_TIME" type="time" step="1" class="form-control mb-2"/><label class="form-label">Finishing position</label><input asp-for="POSITION" type="number" min="1" class="form-control mb-2"/><label class="form-label">Status</label><select asp-for="RESULT_STATUS" class="form-select mb-3"><option>Finished</option><option>Did Not Finish</option><option>Disqualified</option></select><button class="btn btn-warning">Save result</button></form></div>
