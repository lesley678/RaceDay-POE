@model RegisterVm
@{ViewData["Title"]="Register";}<div class="row justify-content-center"><div class="col-lg-8"><div class="card p-4"><h1 class="page-title">Create your RaceDay account</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post"><div class="row"><div class="col-md-6 mb-3"><label asp-for="FIRSTNAME" class="form-label">First name</label><input asp-for="FIRSTNAME" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="LASTNAME" class="form-label">Last name</label><input asp-for="LASTNAME" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="EMAIL" class="form-label">Email</label><input asp-for="EMAIL" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="PASSWORD" class="form-label">Password</label><input asp-for="PASSWORD" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="ROLE" class="form-label">Account type</label><select asp-for="ROLE" class="form-select" id="role"><option>Participant</option><option>Organiser</option></select></div></div><div id="participantFields"><h5>Participant details</h5><label asp-for="DATE_OF_BIRTH" class="form-label">Date of birth</label><input asp-for="DATE_OF_BIRTH" type="date" class="form-control mb-2"/><label asp-for="GENDER" class="form-label">Gender</label><input asp-for="GENDER" class="form-control mb-2"/><label asp-for="EMERGENCY_CONTACT" class="form-label">Emergency contact</label><input asp-for="EMERGENCY_CONTACT" class="form-control mb-3"/></div><div id="organiserFields" hidden><h5>Organiser details</h5><label asp-for="ORGANISATION_NAME" class="form-label">Organisation name</label><input asp-for="ORGANISATION_NAME" class="form-control mb-2"/><label asp-for="ORGANISER_CONTACT_NUMBER" class="form-label">Contact number</label><input asp-for="ORGANISER_CONTACT_NUMBER" class="form-control mb-3"/></div><button class="btn btn-warning">Create account</button></form></div></div></div><script>const role=document.getElementById('role');function toggle(){document.getElementById('participantFields').hidden=role.value!=='Participant';document.getElementById('organiserFields').hidden=role.value!=='Organiser'}role.addEventListener('change',toggle);toggle();</script>
