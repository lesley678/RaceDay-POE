@model EventVm
<div class="card p-4"><div asp-validation-summary="All" class="text-danger"></div><form method="post"><label class="form-label">Event name</label><input asp-for="EVENT_NAME" class="form-control mb-2"/><label class="form-label">Description</label><textarea asp-for="DESCRIPTION" class="form-control mb-2"></textarea><label class="form-label">Date</label><input asp-for="EVENT_DATE" type="date" class="form-control mb-2"/><label class="form-label">Location</label><input asp-for="LOCATION" class="form-control mb-2"/><label class="form-label">Event type</label><select asp-for="EVENT_TYPE" class="form-select mb-2"><option>Run</option><option>Walk</option><option>Cycle</option></select><label class="form-label">Distance (km)</label><input asp-for="DISTANCE" type="number" step="0.01" class="form-control mb-3"/><button class="btn btn-warning">Save event</button></form></div>
